# ─────────────────────────────────────────────────────────────────────────────
# GetBuddin — environment variables
#
# Local development: copy this file to `.env.local` and fill in real values.
# Production: set all of these in the Vercel project (Settings → Environment
# Variables). The old version of this file documented one variable out of six,
# so a fresh clone could not be run.
#
# Anything prefixed VITE_ is bundled into the browser build and is PUBLIC.
# Never put a secret behind a VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (public, shipped to the browser) ─────────────────────────────────

# Supabase project URL. Supabase dashboard → Project Settings → API → Project URL
# Read by: lib/supabase.js
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon/publishable key. Safe to expose — Row Level Security is what
# actually protects the data.
# Supabase dashboard → Project Settings → API → Project API keys → anon public
# Read by: lib/supabase.js, and by every API route for verifying a user's JWT
VITE_SUPABASE_ANON_KEY="eyJ..."

# ── Server (secret — never prefix these with VITE_) ─────────────────────────

# Anthropic API key, used server-side only so it never reaches the browser.
# console.anthropic.com → API Keys
# Read by: api/chat.js, api/infer-profile.js, api/knowme.js
ANTHROPIC_API_KEY="sk-ant-..."

# Same project URL as VITE_SUPABASE_URL, but read from the server runtime.
# Both are needed: Vite only exposes VITE_-prefixed vars to the client, and
# serverless functions only see process.env.
# Read by: every file in api/
SUPABASE_URL="https://your-project.supabase.co"

# Supabase service-role key. BYPASSES Row Level Security — treat it like a
# root password. Server-side only, never in any client file.
# Supabase dashboard → Project Settings → API → Project API keys → service_role
# Read by: every file in api/ (for database reads and writes)
SUPABASE_SERVICE_KEY="eyJ..."

# NOTE on the dual-client pattern: API routes build TWO Supabase clients — one
# with SUPABASE_SERVICE_KEY for data access, and a separate one with
# VITE_SUPABASE_ANON_KEY used only to verify the caller's JWT. The service key
# cannot validate a user token; using it to try returns confusing 401s.
